# ── Required ──
BOT_TOKEN=
DATABASE_URL=postgresql://robin:password@localhost:5432/robin_db

# ── Bot ──
# polling = long-poll getUpdates (recommended for local dev; Telegram cannot reach localhost).
# webhook = HTTP server; requires a public URL (tunnel/production) + setWebhook.
BOT_MODE=polling
BOT_NAME=Nico Robin
DEFAULT_LOCALE=en
DEFAULT_PREFIX=/
# Path secret for POST /webhook/:secret when BOT_MODE=webhook
WEBHOOK_SECRET_PATH=secret-webhook-path

# ── Group allowlist (comma-separated chat IDs, empty = all groups allowed) ──
ALLOWED_GROUP_IDS=

# ── Rate Limiting ──
RATE_LIMIT_USER=20
RATE_LIMIT_GROUP=60
RATE_LIMIT_GLOBAL=300
RATE_LIMIT_COOLDOWN=30
RATE_LIMIT_BAN_THRESHOLD=5

# ── Moderation ──
MODERATION_PROVIDER=disabled
AI_MODERATION_ENABLED=false
AI_SCORE_THRESHOLD=0.75
WARN_THRESHOLD=3

# ── Database ──
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_CONNECT_TIMEOUT=30
DB_QUERY_TIMEOUT=10
DB_POOL_RECYCLE=1800
DB_SSL_REQUIRED=true

# ── Free Tier / Compute Optimization ──
PERSIST_MESSAGE_HISTORY=false
ENABLE_COMMAND_LOGGING=false

# ── Logging ──
ENVIRONMENT=local
LOG_LEVEL=INFO
LOG_CHANNEL_ID=0
AUTO_MIGRATE_ON_STARTUP=true
SENTRY_DSN=

# ── Misc ──
PORT=8000
